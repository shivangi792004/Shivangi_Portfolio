# ==============================================================================
# Environment Configuration Template for Shivangi Singh's Portfolio
# ==============================================================================

# Canonical Production URL (used by Vite, Sitemap, Robots, and Open Graph metadata)
VITE_SITE_URL=https://shivangi-portfolio.vercel.app

# ------------------------------------------------------------------------------
# EmailJS Dispatch Settings (Optional)
# ------------------------------------------------------------------------------
# Free tier credentials from https://emailjs.com
# If left blank, contact form falls back seamlessly to direct mailto client
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
